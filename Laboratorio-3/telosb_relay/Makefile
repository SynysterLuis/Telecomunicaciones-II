APPLICATION = telosb_relay
BOARD ?= telosb
RIOTBASE ?= $(CURDIR)/../../..

INCLUDES += -I$(APPDIR)

USEMODULE += cc2420
USEMODULE += shell

NODE_ID ?= 2
CFLAGS += -DNODE_ID=$(NODE_ID)

NEXT_HOP_ID ?= 3
FINAL_DEST_ID ?= 3
CFLAGS += -DNEXT_HOP_ID=$(NEXT_HOP_ID)
CFLAGS += -DFINAL_DEST_ID=$(FINAL_DEST_ID)

# 1 = CSMA/CCA activado; 0 = desactivado
CSMA ?= 1
CFLAGS += -DCSMA_ENABLED=$(CSMA)

RADIO_THREAD_STACKSIZE ?= 1024
CFLAGS += -DRADIO_THREAD_STACKSIZE=$(RADIO_THREAD_STACKSIZE)

include $(RIOTBASE)/Makefile.include
